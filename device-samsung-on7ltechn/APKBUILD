# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-samsung-on7ltechn
pkgdesc="Samsung Galaxy On7 (2015) (China, SM-G6000)"
pkgver=0
pkgrel=5
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	postmarketos-base
	mkbootimg
	linux-postmarketos-qcom-msm8916
	soc-qcom-msm8916
	soc-qcom-msm8916-rproc
"
makedepends="devicepkg-dev"
source="deviceinfo modules-initfs"
subpackages="
	$pkgname-nonfree-firmware:nonfree_firmware
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	# 屏幕旋转：显示转 90°，触摸用 xinput 矩阵同步（见 rotate-screen.sh）
	# 注意：abuild 禁止 /usr/local 与 /lib（usrmerge 下用 /usr/lib）
	install -Dm755 "$startdir"/rotate-screen.sh \
		"$pkgdir"/usr/bin/rotate-screen.sh
	install -Dm644 "$startdir"/screen-rotate.desktop \
		"$pkgdir"/etc/xdg/autostart/screen-rotate.desktop
	# Adreno 306 固件由 firmware-qcom-adreno-a300 提供（见 nonfree_firmware
	# 子包的 depends），不要在这里重复安装，否则 apk 会报文件冲突。
}

nonfree_firmware() {
	pkgdesc="GPU/WiFi/BT/Modem/Video firmware"
	depends="firmware-qcom-adreno-a300 msm-firmware-loader firmware-samsung-on7-wcnss-nv"
	mkdir "$subpkgdir"
}

sha512sums="
