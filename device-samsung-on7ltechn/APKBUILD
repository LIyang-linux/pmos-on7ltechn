# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-samsung-on7ltechn
pkgdesc="Samsung Galaxy On7 (2015) (China, SM-G6000)"
pkgver=0
pkgrel=7
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	postmarketos-base
	mkbootimg
	linux-postmarketos-qcom-msm8916
	soc-qcom-msm8916
	soc-qcom-msm8916-rproc
"
makedepends="devicepkg-dev"
source="deviceinfo modules-initfs mkinitfs-firmware.files"
subpackages="
	$pkgname-nonfree-firmware:nonfree_firmware
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	# Adreno 306 固件由 firmware-qcom-adreno-a300 提供（见 nonfree_firmware
	# 子包的 depends），不要在这里重复安装，否则 apk 会报文件冲突。
	#
	# 但必须把固件放进 initramfs：GPU 在内核启动早期就 probe，那时 rootfs
	# 还没挂载，request_firmware() 拿不到 /lib/firmware 里的 a300_*.fw，
	# 导致 kgsl 设备没创建、GPU 完全不可用（phoc 退回软件渲染 → 卡死）。
	# 这里通过 mkinitfs 的 .files 机制把固件打进 initramfs。
	install -Dm644 "$startdir"/mkinitfs-firmware.files \
		"$pkgdir"/usr/share/mkinitfs/files/50-$pkgname-firmware.files
}

nonfree_firmware() {
	pkgdesc="GPU/WiFi/BT/Modem/Video firmware"
	depends="firmware-qcom-adreno-a300 msm-firmware-loader firmware-samsung-on7-wcnss-nv"
	mkdir "$subpkgdir"
}

