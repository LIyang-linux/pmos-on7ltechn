# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.

deviceinfo_format_version="0"
deviceinfo_name="Samsung Galaxy On7 (2015) (China, SM-G6000)"
deviceinfo_manufacturer="Samsung"
deviceinfo_codename="samsung-on7ltechn"
deviceinfo_year="2015"

# NOTE: 目前与 samsung-on7 共用同一份 DTB（msm8916-samsung-on7）。
# G6000 下游代号为 o7lte-chn，面板/触摸与 G600F 可能不同，
# 若显示或触摸异常，需要在 mainline 内核中新建
# arch/arm64/boot/dts/qcom/msm8916-samsung-on7ltechn.dts 并改这里。
deviceinfo_dtb="qcom/msm8916-samsung-on7"
deviceinfo_append_dtb="true"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="handset"
deviceinfo_external_storage="true"
deviceinfo_screen_width="720"
deviceinfo_screen_height="1280"
deviceinfo_getty="ttyMSM0;115200"

# USB 网络（在 Windows 上必须覆盖默认值）
# pmOS 的 USB gadget 默认 VID:PID = 18D1:D001（Google / "Nexus 4 fastboot"）。
# Windows 装了 Google USB Driver 时，会按 VID/PID 把这块网卡认成
# "Android ADB Recovery Interface" 并绑到 WinUSB，导致：
#   - 设备管理器里出现一个 ADB 设备，但 adb devices 为空
#     （pmOS 不运行 adbd，initramfs 只有 network/mass_storage/ACM）
#   - 真正的 USB 网卡不出现，172.16.42.1 不通，SSH 用不了
# 改用 Linux Foundation 的通用 ID 并强制 RNDIS（Windows 自带该驱动）。
deviceinfo_usb_idVendor="0x1d6b"
deviceinfo_usb_idProduct="0x0104"
deviceinfo_usb_network_function="rndis.usb0"

# Bootloader related
deviceinfo_flash_method="fastboot"
deviceinfo_kernel_cmdline="earlycon console=ttyMSM0,115200"
deviceinfo_generate_bootimg="true"
deviceinfo_generate_extlinux_config="true"
deviceinfo_bootimg_qcdt="false"
deviceinfo_flash_pagesize="2048"
deviceinfo_flash_offset_base="0x80000000"
deviceinfo_flash_offset_kernel="0x00080000"
deviceinfo_flash_offset_ramdisk="0x02000000"
deviceinfo_flash_offset_second="0x00f00000"
deviceinfo_flash_offset_tags="0x01e00000"
deviceinfo_flash_sparse="true"

# lk2nd does not support GPT for subpartitions/SD cards yet
deviceinfo_partition_type="msdos"

# lk2nd 内置的是 LK 的 ext2 驱动：只接受 ro_compat 为 SPARSE_SUPER|LARGE_FILE
# 的超级块，且只认经典块映射，读不了 ext4（extents/64bit/metadata_csum）。
# 所以 extlinux.conf 与内核必须放在独立的 ext2 启动分区；根分区用 ext4 无妨，
# lk2nd 不会去读它，挂载 root 是内核的事。
deviceinfo_boot_filesystem="ext2"
