+static int s6d7aa0_bv050hdm_off(struct s6d7aa0 *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+
+	mipi_dsi_dcs_write_seq(dsi, MIPI_DCS_SET_DISPLAY_OFF, 0x00);
+
+	return 0;
+}
