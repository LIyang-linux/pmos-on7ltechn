--- a/arch/arm64/boot/dts/qcom/msm8916-samsung-on7.dts
+++ b/arch/arm64/boot/dts/qcom/msm8916-samsung-on7.dts
@@ -319,3 +319,26 @@
 		};
 	};
 };
+
+/* SM5703 charger: bit-banged I2C, SDA=gpio22 SCL=gpio23 (downstream rev03) */
+/* mrstb = gpio24，复位芯片退出 shipping mode */
+/ {
+	i2c_chg: i2c_gpio_chg {
+		compatible = "i2c-gpio";
+		sda-gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
+		scl-gpios = <&tlmm 23 GPIO_ACTIVE_HIGH>;
+		i2c-gpio,delay-us = <2>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		sm5703_mfd: sm5703-mfd@49 {
+			compatible = "siliconmitus,sm5703mfd";
+			reg = <0x49>;
+			mrstb-gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
+
+			charger: charger {
+				compatible = "siliconmitus,sm5703-charger";
+			};
+		};
+	};
+};
